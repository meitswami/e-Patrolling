# Shakti - the 3rd Eye — edit this file beside the .exe before first run
ENVIRONMENT=production
PATROL_PORTABLE=true
PORTABLE_PORT=8765
CRAWLER_HEADLESS=true
CRAWLER_SCHEDULER_ENABLED=false
REDIS_ENABLED=false
USE_ML_CLASSIFIER=false
PRELOAD_AI_MODELS=false
DATABASE_SSL=true
DATABASE_SSL_VERIFY=false
DATABASE_FORCE_IPV4=true
ALLOWED_ORIGINS=["http://127.0.0.1:8765","http://localhost:8765"]

# REQUIRED — copy Session pooler URI from Supabase Dashboard -> Connect (port 5432)
# Username MUST be postgres.PROJECT_REF  |  Host MUST match dashboard (aws-0 or aws-1 + region)
# Do NOT use db.*.supabase.co on Windows. Do NOT guess the region.
# e-Patrolling project whzmtzatkxgiomwlwkgy — Session pooler host (copy from dashboard if this changes)
DATABASE_URL=postgresql+asyncpg://postgres.whzmtzatkxgiomwlwkgy:YOUR_PASSWORD@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres

# Same JWT_SECRET_KEY as EC2 / dev .env (decrypts Instagram password stored in Supabase)
JWT_SECRET_KEY=patrol_dev_change_in_production_use_openssl_rand_hex_32

# Default login (created on first successful DB connect):
# admin@patrol.dev / Patrol@2024!
