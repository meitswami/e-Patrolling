# Portable PATROL — copy beside e-Patrol.exe as .env
ENVIRONMENT=production
PATROL_PORTABLE=true
PORTABLE_PORT=8765
CRAWLER_HEADLESS=true
CRAWLER_SCHEDULER_ENABLED=false
REDIS_ENABLED=false
USE_ML_CLASSIFIER=false
PRELOAD_AI_MODELS=false
DATABASE_SSL_VERIFY=false
ALLOWED_ORIGINS=["http://127.0.0.1:8765","http://localhost:8765"]

# Required: your Supabase connection string
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

JWT_SECRET_KEY=change_this_portable_secret_before_sharing
