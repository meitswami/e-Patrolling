# PATROL — copy to repo root .env (recommended) or backend/.env on EC2
# Settings loads BOTH: .env then backend/.env (backend overrides).

ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# ── Supabase (required) ─────────────────────────────────────
# Local (IPv6 OK): direct db.<ref>.supabase.co:5432 with user postgres
# EC2 (IPv4 only): Dashboard → Connect → Session pooler (NOT direct db. host)
#   postgresql+asyncpg://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# DATABASE_URL=postgresql+asyncpg://postgres.whzmtzatkxgiomwlwkgy:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.whzmtzatkxgiomwlwkgy.supabase.co:5432/postgres

SUPABASE_URL=https://whzmtzatkxgiomwlwkgy.supabase.co
SUPABASE_PROJECT_REF=whzmtzatkxgiomwlwkgy
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_SSL=true
# Use pooler URL on EC2; this only helps if the DB host has an IPv4 A record
DATABASE_FORCE_IPV4=true

# For Cursor Supabase MCP (.cursor/mcp.json uses SUPABASE_PROJECT_REF)
# Set in OS env or Cursor Settings → MCP → supabase → env

# ── Redis (optional for MVP auth; required for queue later) ─
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

JWT_SECRET_KEY=change_this_use_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# CORS — comma-separated or JSON array (required in production)
ALLOWED_ORIGINS=https://shakti.meitcybersolutions.com,http://localhost:3000
# Optional extras (leave empty on dedicated VPS)
# CORS_EXTRA_ORIGINS=

PRELOAD_AI_MODELS=false
USE_ML_CLASSIFIER=false
USE_MULTILINGUAL_TOXIC=true
USE_HF_INFERENCE_API=false
HUGGINGFACE_API_TOKEN=
# If true: pip install -r requirements-ml.txt  (torch 2.9+ on Python 3.14)
USE_INDICBERT=false
CAPTURE_EVIDENCE_SCREENSHOTS=true
EVIDENCE_SCREENSHOT_MODE=both
# Or configure via Admin → Settings (saved to system_settings table):
# CRAWLER_DEMO_MODE, INSTAGRAM_USERNAME, INSTAGRAM_PASSWORD, EVIDENCE_SCREENSHOT_MODE
USE_GPU=false
FACEBOOK_ACCESS_TOKEN=
TWITTER_BEARER_TOKEN=

EVIDENCE_STORAGE_PATH=./storage/evidence
SCREENSHOTS_PATH=./storage/screenshots

CRAWLER_HEADLESS=true
CRAWLER_DEMO_MODE=true
CRAWLER_SCHEDULER_ENABLED=true
# Historical crawl (Crawl history): lower = faster, higher = more posts/comments loaded
# HISTORICAL_CRAWL_MAX_POSTS=12
# HISTORICAL_CRAWL_MAX_COMMENTS_PER_POST=80
# HISTORICAL_CRAWL_COMMENT_EXPAND_ROUNDS=15
# HISTORICAL_CRAWL_POST_DELAY_SEC=2.0
CRAWL_INTERVAL_SECONDS=300
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
ADMIN_EMAIL=admin@patrol.dev
ADMIN_PASSWORD=Patrol@2024!
ADMIN_NAME=System Administrator

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
