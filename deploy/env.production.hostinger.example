# PATROL — production Hostinger VPS (scp to ~/e-Patrolling/.env)
# Settings loads: repo-root .env then backend/.env (backend overrides).
#
#   scp deploy/env.production.hostinger ubuntu@187.127.185.243:~/e-Patrolling/.env

ENVIRONMENT=production
LOG_LEVEL=INFO
DEBUG=false

# ── Supabase (Session pooler — IPv4, same DB as former EC2) ───
SUPABASE_PROJECT_REF=whzmtzatkxgiomwlwkgy
SUPABASE_URL=https://whzmtzatkxgiomwlwkgy.supabase.co
DATABASE_URL=postgresql+asyncpg://postgres.whzmtzatkxgiomwlwkgy:YOUR_SUPABASE_PASSWORD@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_SSL=true
DATABASE_FORCE_IPV4=false

# ── Redis (optional) ────────────────────────────────────────
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ── Auth ────────────────────────────────────────────────────
JWT_SECRET_KEY=change_me_use_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# CORS — Hostinger Shakti + bojprtest.in + Vercel (if still used)
ALLOWED_ORIGINS=https://shakti.bojprtest.in,https://bojprtest.in,https://www.bojprtest.in,https://e-patrolling.vercel.app,http://localhost:3000

# ── AI / crawler ─────────────────────────────────────────────
PRELOAD_AI_MODELS=false
USE_ML_CLASSIFIER=false
USE_MULTILINGUAL_TOXIC=true
USE_HF_INFERENCE_API=false
HUGGINGFACE_API_TOKEN=
USE_INDICBERT=false
CAPTURE_EVIDENCE_SCREENSHOTS=true
EVIDENCE_SCREENSHOT_MODE=both
USE_GPU=false
CRAWLER_HEADLESS=true
CRAWLER_DEMO_MODE=false
CRAWLER_SCHEDULER_ENABLED=false
CRAWL_INTERVAL_SECONDS=0
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

EVIDENCE_STORAGE_PATH=./storage/evidence
SCREENSHOTS_PATH=./storage/screenshots

ADMIN_EMAIL=admin@patrol.dev
ADMIN_PASSWORD=Patrol@2024!
ADMIN_NAME=System Administrator

# Frontend static build on Hostinger (nginx serves /var/www/shakti)
NEXT_PUBLIC_API_URL=https://shakti.bojprtest.in
NEXT_PUBLIC_WS_URL=wss://shakti.bojprtest.in

HISTORICAL_CRAWL_MAX_POSTS=6
HISTORICAL_CRAWL_MAX_COMMENTS_PER_POST=40
HISTORICAL_CRAWL_COMMENT_EXPAND_ROUNDS=8
HISTORICAL_CRAWL_COMMENT_SCROLL_ROUNDS=5
HISTORICAL_CRAWL_POST_DELAY_SEC=1.0
HISTORICAL_CRAWL_PROFILE_SCROLL_DELAY_SEC=1.0
